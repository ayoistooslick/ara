# Copy to /etc/ara/ara.env and chmod 600. Replace the password.
ARA_HOME=/var/lib/ara
ARA_WEB_PASSWORD=replace-with-a-long-random-password

# Pick one inference backend.
# Hosted ara-ng (HTTPS only; auto-selected when this is set):
# ARA_HOSTED_URL=https://your-ara-ng-endpoint.example/v1
# ARA_HOSTED_API_KEY=replace-with-the-service-key
# ARA_HOSTED_MODEL=ara-ng

# Or a local OpenAI-compatible server (the default URL is shown):
# ARA_MODEL_URL=http://127.0.0.1:8080/v1
# ARA_MODEL_NAME=your-model-id

# Optional perception services, also local.
# ARA_VISION_URL=http://127.0.0.1:8082/v1
# ARA_AUDIO_URL=http://127.0.0.1:8083/v1
