# Copy to /etc/ara/ara.env and chmod 600. Replace the password.
ARA_HOME=/var/lib/ara
ARA_WEB_PASSWORD=replace-with-a-long-random-password
# Point these at local services, not public endpoints.
# ARA_MODEL_URL=http://127.0.0.1:8080/v1
# ARA_MODEL_NAME=your-model-id
# ARA_VISION_URL=http://127.0.0.1:8082/v1
# ARA_AUDIO_URL=http://127.0.0.1:8083/v1
